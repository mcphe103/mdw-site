# Required: API key used to send contact-form email through Resend.
RESEND_API_KEY=replace_with_a_resend_api_key

# Required: verified sender used for both contact-form messages.
CONTACT_FROM_EMAIL=McPherson Digital Works <contact@example.com>

# Required: private MDW inbox that receives contact submissions.
CONTACT_TO_EMAIL=owner@example.com

# Optional: comma-separated additional origins allowed to submit the form.
# The request URL's own origin is always allowed.
CONTACT_ALLOWED_ORIGINS=https://www.example.com
